#! /usr/bin/env python3
# Convert code to PDF via Typst

import subprocess
import argparse
import os
import sys
from pathlib import Path

# The top part of the template pulls strings from the CLI inputs
TYPST_TEMPLATE_TOP = r"""
#import "@preview/codly:1.3.0": *

#let COURSE = sys.inputs.at("course", default: "Course")
#let ASSIGNMENT = sys.inputs.at("assignment", default: "Assignment")
#let AUTHOR = sys.inputs.at("author", default: "Author")
"""

# The bottom part sets up formatting and loops over our dynamically injected TARGET_FILES
TYPST_TEMPLATE_BOTTOM = r"""
#set page(margin: 0.75in, numbering: "1", paper: "us-letter", header-ascent: 20%)
#set par(leading: 0.6em, justify: true)
#set text(font: "DejaVu Sans Mono", size: 7pt)
#show raw: set text(font: "DejaVu Sans Mono", size: 7pt)
#show par: set block(spacing: 1.4em)
#show heading: set block(above: 1.4em, below: 1em)
#show link: set text(rgb(0, 0, 255))
#show figure: set block(breakable: true)

#show: codly-init.with()
#codly(zebra-fill: none)

#let codeblock(filename) = {
  // Using posix paths from Python, so we only need to split by forward slash
  let display_name = filename.split("/").at(-1)

  set page(
    header: [
      #COURSE #h(1fr) #ASSIGNMENT - #display_name #h(1fr) #AUTHOR
      #move(dy: -1em, line(length: 100%)) 
    ]
  )
  counter(page).update(1)
  raw(read(filename), block: true)
  pagebreak(weak: true, to: "odd")
}

#if TARGET_FILES.len() > 0 {
  for file in TARGET_FILES {
    codeblock(file)
  }
} else {
  [Error: No files specified]
}
"""

def run():
    parser = argparse.ArgumentParser(description="Convert multiple code files into a single PDF via Typst")
    
    # New Arguments
    parser.add_argument("files", nargs="+", help="Input source code files to convert")
    parser.add_argument("-c", "--course", default="COURSE", help="Course name (e.g., 'EE/CS 10a')")
    parser.add_argument("-a", "--assignment", default="ASSIGNMENT", help="Assignment name (e.g., 'Homework #2')")
    parser.add_argument("-n", "--author", default="AUTHOR", help="Author name for header")
    parser.add_argument("-o", "--output", default="output.pdf", help="Output PDF filename (default: output.pdf)")
    
    args = parser.parse_args()

    # Validate all input files exist before proceeding
    posix_paths = []
    for f in args.files:
        p = Path(f).resolve()
        if not p.exists():
            print(f"Error: File '{p}' not found.")
            sys.exit(1)
        # Typst requires POSIX style paths to read cleanly across OSs
        posix_paths.append(p.as_posix())

    temp_typ = Path(".code2pdf.typ")
    output_pdf = Path(args.output).resolve()

    # Dynamically inject the array of validated file paths into the Typst template
    files_array_str = ", ".join(f'"{p}"' for p in posix_paths)
    injected_files_let = f"\n#let TARGET_FILES = ({files_array_str},)\n"
    
    full_template = TYPST_TEMPLATE_TOP + injected_files_let + TYPST_TEMPLATE_BOTTOM

    # Write the embedded template to a temporary file
    temp_typ.write_text(full_template, encoding="utf-8")

    # Construct command
    # We set root to / (or C:\) to allow reading the input file from any location
    root_dir = Path(os.path.abspath(os.sep))

    command = [
        "typst", "compile",
        "--input", f"course={args.course}",
        "--input", f"assignment={args.assignment}",
        "--input", f"author={args.author}",
        "--root", str(root_dir),
        str(temp_typ),
        str(output_pdf)
    ]

    try:
        print(f"Processing {len(args.files)} files into {output_pdf.name}...")
        subprocess.run(command, check=True, capture_output=True, text=True)
        print(f"Created {output_pdf.name} successfully.")
    except subprocess.CalledProcessError as e:
        print("Typst Error:")
        print(e.stderr)
    except FileNotFoundError:
        print("Error: 'typst' executable not found in PATH.")
    finally:
        # Clean up temporary Typst file
        if temp_typ.exists():
            temp_typ.unlink()

if __name__ == "__main__":
    run()
